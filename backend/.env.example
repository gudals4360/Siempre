# 이 파일을 .env로 복사해서 쓴다. .env는 커밋하지 않는다. (이름은 shared/README.md 5장 기준)

# 공통
PORT=8787
# SQLite 파일 위치 (backend/ 기준 상대 경로 또는 file: 주소)
DATABASE_URL=data/siempre.db

# auth (김형민): Firebase 프로젝트 ID (웹 설정의 projectId와 같은 값). 로그인 토큰 확인에 쓴다.
# 서비스 계정 키는 필요 없다 (구글 공개 인증서로 확인).
FIREBASE_PROJECT_ID=
# 시연 모드: 1이면 Firebase 없이 로그인 화면의 "시연용 관리자로 로그인" 버튼으로 들어갈 수 있다 (MVP 발표용).
# 비밀번호 없이 들어가는 계정이라 운영 배포에서는 절대 켜지 않는다.
DEMO_LOGIN=
# 프록시 뒤에서 요청 제한에 X-Forwarded-For를 쓸 때 1
TRUST_PROXY=

# chat (권희수): 입점 AI별 키 (PRD 3-1)
# OPENAI_API_KEY=
